{
  "rules": {
    "signalr-premium-for-zone-resilience": {
      "test": {
        "fires": {
          "region": "eastus2",
          "options": [
            {
              "name": "A",
              "components": [
                {
                  "type": "signalr",
                  "tier": "standard",
                  "units": 1
                }
              ]
            }
          ],
          "context": {
            "production": true,
            "zoneResilience": true
          },
          "discountPct": 0
        },
        "silent": {
          "region": "eastus2",
          "options": [
            {
              "name": "A",
              "components": [
                {
                  "type": "signalr",
                  "tier": "premium",
                  "units": 1
                }
              ]
            }
          ],
          "context": {
            "production": true,
            "zoneResilience": true
          },
          "discountPct": 0
        }
      }
    },
