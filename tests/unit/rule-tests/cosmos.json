{
  "rules": {
    "cosmos-standard-availability-zone-surcharge": {
      "test": {
        "fires": {
          "region": "eastus2",
          "options": [
            {
              "name": "a",
              "components": [
                {
                  "type": "cosmos",
                  "mode": "provisioned",
                  "ru": 1000,
                  "zoneRedundant": true
                }
              ]
            }
