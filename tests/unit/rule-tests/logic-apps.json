{
  "rules": {
    "logic-apps-ise-retired": {
      "test": {
        "fires": {
          "region": "eastus2",
          "discountPct": 0,
          "options": [
            {
              "name": "A",
              "components": [
                {
                  "type": "logic-apps",
                  "plan": "ise",
                  "iseTier": "developer"
                }
              ]
            }
          ]
        },
        "silent": {
          "region": "eastus2",
          "discountPct": 0,
          "options": [
            {
              "name": "A",
              "components": [
                {
                  "type": "logic-apps",
                  "plan": "standard",
                  "hostingPlan": "ws1"
                }
              ]
            }
          ]
        }
      }
    },
    "logic-apps-standard-zone-redundancy": {
