                }
              ]
            }
          ]
        },
        "silent": {
          "region": "eastus2",
          "discountPct": 0,
          "context": {
            "production": true
          },
          "options": [
            {
              "name": "A",
              "components": [
                {
                  "type": "logic-apps",
                  "plan": "standard",
                  "hostingPlan": "ws1",
                  "instances": 2
                }
              ]
            }
          ]
        }
      }
    }
  }
