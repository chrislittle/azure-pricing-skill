{
  "rules": {
    "virtual-desktop-per-user-external-only": {
      "test": {
        "fires": {
          "region": "eastus2",
          "discountPct": 0,
          "options": [
            {
              "name": "A",
              "components": [
                {
                  "type": "virtual-desktop",
                  "desktopUsers": 10
                }
              ]
            }
          ]
        },
        "silent": {
          "region": "eastus2",
          "discountPct": 0,
          "options": [
            {
              "name": "A",
              "components": [
                {
                  "type": "virtual-desktop",
                  "hciPhysicalCores": 8
                }
              ]
            }
          ]
        }
      }
    },
    "virtual-desktop-separate-subscription": {
