{
  "rules": {
    "traffic-manager-longer-ttl": {
      "test": {
        "fires": {
          "region": "eastus2",
          "options": [
            {
              "name": "a",
              "components": [
                {
                  "type": "traffic-manager",
                  "dnsQueriesMillions": 500,
                  "azureEndpoints": 2
                }
              ]
            }
          ]
        },
        "silent": {
          "region": "eastus2",
          "options": [
            {
              "name": "a",
              "components": [
                {
                  "type": "traffic-manager",
                  "dnsQueriesMillions": 10,
                  "azureEndpoints": 2
                }
              ]
            }
          ]
        }
      }
    },
