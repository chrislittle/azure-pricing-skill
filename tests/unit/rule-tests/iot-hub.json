{
  "rules": {
    "iot-hub-free-production": {
      "test": {
        "fires": {
          "region": "eastus2",
          "discountPct": 0,
          "context": {
            "production": true
          },
          "options": [
            {
              "name": "A",
              "components": [
                {
                  "type": "iot-hub",
                  "messagesPerDay": 5000,
                  "tier": "free"
                }
              ]
            }
          ]
        },
        "silent": {
          "region": "eastus2",
          "discountPct": 0,
          "context": {
            "production": true
          },
          "options": [
            {
              "name": "A",
              "components": [
                {
                  "type": "iot-hub",
                  "messagesPerDay": 5000,
                  "tier": "standard"
                }
              ]
            }
          ]
        }
      }
    },
