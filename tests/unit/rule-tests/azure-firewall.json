{
  "rules": {
    "azure-firewall-delete-unused": {
      "test": {
        "silent": {
          "region": "eastus2",
          "context": {
            "production": false
          },
          "options": [
            {
              "name": "a",
              "components": [
                {
                  "dataGB": 100,
                  "hours": 100,
                  "type": "azure-firewall",
                  "firewalls": 1,
                  "tier": "standard"
                }
              ]
            }
          ]
        },
        "fires": {
          "region": "eastus2",
          "context": {
            "production": false
          },
          "options": [
            {
              "name": "a",
              "components": [
                {
                  "dataGB": 100,
                  "type": "azure-firewall",
                  "firewalls": 1,
                  "tier": "standard"
                }
              ]
            }
          ]
        }
      }
    },
