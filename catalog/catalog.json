  "vmLifecycle": {
    "overview": "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/lifecycle-overview",
    "restrictions": "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions",
    "endOfLifeList": "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/end-of-life-sizes-list",
    "verified": "2026-10-01 against pages dated 2026-09-25",
    "policy": "Only Current and Extended size series are priced. Every series on the End of Life list, or retired, is refused.",
    "retire2029Pattern": "^Standard_[DE]\\d+(-\\d+)?s?_v3$",
    "endOfLife": [
      {
        "series": "B-series (v1)",
        "pattern": "^Standard_B\\d+(ls|ms|s|ts)$"
      },
      {
        "series": "Standard D-series (v1) and memory-optimized D-series",
        "pattern": "^Standard_D\\d+$"
      },
      {
        "series": "DS-series and memory-optimized DS-series",
        "pattern": "^Standard_DS\\d+(-\\d+)?$"
      },
      {
        "series": "Dv2 and Dsv2",
        "pattern": "^Standard_DS?\\d+(-\\d+)?_v2(_Promo)?$"
      },
      {
        "series": "Dv3 and Dsv3",
        "pattern": "^Standard_D\\d+s?_v3$"
      },
      {
        "series": "Av2 and Amv2",
        "pattern": "^Standard_A\\d+m?_v2$"
      },
      {
        "series": "DCsv3 and DCdsv3",
        "pattern": "^Standard_DC\\d+d?s_v3$"
      },
      {
        "series": "F, Fs and Fsv2",
        "pattern": "^Standard_F\\d+s?(_v2)?$"
      },
      {
        "series": "Ev3 and Esv3",
        "pattern": "^Standard_E\\d+(-\\d+)?s?_v3$"
      },
      {
        "series": "G and GS",
        "pattern": "^Standard_GS?\\d+(-\\d+)?$"
      },
      {
        "series": "Msv2 and Mdsv2 isolated sizes",
        "pattern": "^Standard_M192id?m?s_v2$"
      },
      {
        "series": "Lsv1 and Lsv2",
        "pattern": "^Standard_L\\d+s(_v2)?$"
      },
      {
        "series": "NVv3",
        "pattern": "^Standard_NV\\d+s_v3$"
      },
      {
        "series": "NVv4",
        "pattern": "^Standard_NV\\d+as_v4$"
      },
      {
        "series": "NP",
        "pattern": "^Standard_NP\\d+s$"
      },
      {
        "series": "HC",
        "pattern": "^Standard_HC\\d+(-\\d+)?r?s$"
      },
      {
        "series": "HBv2",
        "pattern": "^Standard_HB\\d+(-\\d+)?r?s_v2$"
      },
      {
        "series": "A-series (v1) and Basic A",
        "stage": "Retired",
        "pattern": "^(Basic|Standard)_A\\d+$"
      },
      {
        "series": "NC v1 to v3, ND v1, NV v1 and v2",
        "stage": "Retired",
        "pattern": "^Standard_(NC\\d+r?|NC\\d+r?s_v[23]|ND\\d+r?s|NV\\d+|NV\\d+s_v2)$"
      },
      {
        "series": "H and HB (v1)",
        "stage": "Retired",
        "pattern": "^Standard_(H\\d+[mr]*|HB60(-\\d+)?rs)$"
      }
    ]
  },
